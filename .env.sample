# Environment: dev, qa, prod
ENV=dev

# Bot Configuration
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_SUDO_ADMINS=123456789,987654321
WEBHOOK_URL=https://1234567890.ngrok.io
WEBHOOK_SECRET=1234567890

# Database
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_USER=postgres
PSQL_PASS=123456
PSQL_DBNAME=ABC
PSQL_SSLMODE=disable
PSQL_MAX_OPEN_CONNS=10
PSQL_MAX_IDLE_CONNS=5
PSQL_CONN_MAX_LIFETIME=0

# Redis
REDIS_URI=redis://localhost:6379

# Logger
LOG_LEVEL=info
LOG_PRETTY=true